{
  "name": "@1agents/dsh-plugin-todo",
  "version": "0.1.0",
  "description": "管理本机已同步的系统提醒事项和日历。页面在 DSH，工具在 dreammate-node MCP。",
  "type": "module",
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/DSH-Plugin-Todo.git"
  },
  "homepage": "https://github.com/scottzx/DSH-Plugin-Todo#readme",
  "bugs": {
    "url": "https://github.com/scottzx/DSH-Plugin-Todo/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "ios-agenda": "bin/ios-agenda.mjs"
  },
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/host.js",
    "dist/client.js",
    "dist/IosAgenda.app",
    "bin",
    "skills/ios-agenda",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/protocol.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
